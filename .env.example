# Copy to ".env" and fill in. NEVER commit the real .env (it holds the secret).
#   cp .env.example .env

# The shared secret the bastion sends and the agent checks. Generate with:
#   openssl rand -hex 32
AGENT_TOKEN=replace-with-a-long-random-token

# Host IP the agent is published on (the bastion connects here).
AGENT_BIND_IP=192.168.255.30

# Host path to the agent's read-only kubeconfig (owned by uid 1000, mode 600).
AGENT_KUBECONFIG=/etc/ai-agent/kubeconfig

# The local model to use (keep equal to config.yaml ollama.model).
OLLAMA_MODEL=qwen2.5:7b-instruct-q5_K_M

# Optional: short git sha for build traceability. Set with:
#   export GIT_SHA=$(git rev-parse --short HEAD)
GIT_SHA=unknown
